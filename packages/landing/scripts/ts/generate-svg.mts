/**
 * Generates a TypeScript module with all SVG strings of one topic.
 * Run: node scripts/ts/generate-svg.mts [topic ...]
 *
 * This script reads all SVG files from src/content/ts/design-system/<topic>/svg/
 * and generates src/content/ts/design-system/<topic>/svg-generated.ts
 *
 * With no argument it regenerates every topic that has an svg/ folder.
 */

import { readFileSync, writeFileSync, readdirSync, existsSync, statSync } from 'node:fs';
import { resolve, basename, join } from 'node:path';

const CONTENT_DIR = resolve('src/content/ts/design-system');

/** Every folder under the content directory that holds an svg/ folder. */
const topics = readdirSync(CONTENT_DIR)
  .map((name) => join(CONTENT_DIR, name))
  .filter((dir) => statSync(dir).isDirectory())
  .filter((dir) => existsSync(join(dir, 'svg')))
  .map((dir) => basename(dir));

const wanted = process.argv.slice(2);
const selected = wanted.length ? wanted : topics;

if (wanted.length) {
  const missing = wanted.filter((topic) => !topics.includes(topic));
  if (missing.length) {
    console.error(`No svg/ folder for: ${missing.join(', ')}`);
    process.exit(1);
  }
}

for (const topic of selected) {
  const svgDir = resolve(CONTENT_DIR, topic, 'svg');
  const outputFile = resolve(CONTENT_DIR, topic, 'svg-generated.ts');
  const files = readdirSync(svgDir)
    .filter((f) => f.endsWith('.svg'))
    .sort();

  let output = `// Auto-generated by scripts/ts/generate-svg.mts - do not edit manually\n\n`;

  for (const file of files) {
    const name = basename(file, '.svg').replace(/-/g, '_');
    const content = readFileSync(resolve(svgDir, file), 'utf-8')
      .replace(/`/g, '\\`')
      .replace(/\$\{/g, '\\${');
    output += `export const ${name} = \`${content}\`;\n`;
  }

  writeFileSync(outputFile, output);
  console.log(`Generated ${outputFile} with ${files.length} SVGs`);
}
