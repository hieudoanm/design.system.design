{
  "name": "design.system.design",
  "version": "0.0.1",
  "description": "Design System Design is a comprehensive design system that provides a set of reusable components, guidelines, and best practices for creating consistent and visually appealing user interfaces. It aims to streamline the design and development process by offering a unified approach to design across different platforms and devices.",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "26.13.1"
  },
  "scripts": {
    "analyze": "next analyze",
    "format": "prettier --cache --write .",
    "format:check": "prettier --cache --check .",
    "lint:fix": "eslint . --fix",
    "lint": "eslint .",
    "predev": "rimraf .next && kill-port 3000",
    "dev": "next dev",
    "prebuild": "rimraf .next && pnpm lint && pnpm format:check",
    "build": "next build",
    "postbuild": "node scripts/ts/generate-sitemap.mts && touch out/.nojekyll",
    "prestart": "kill-port 3000",
    "start": "node scripts/ts/serve.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:video": "playwright test && node scripts/ts/generate-assets.mts",
    "typecheck": "tsc --noEmit",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "mermaid": "12.3.0",
    "motion": "14.12.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-react": "7.37.5",
    "ffmpeg-static": "5.3.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jsdom": "31.0.0",
    "kill-port": "2.0.1",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "rimraf": "6.1.4",
    "shiki": "4.6.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
