/**
 * Generates a TypeScript module with all SVG strings.
 * Run: node scripts/ts/generate-icons.mts
 * This script reads all SVG files from src/content/ts/design-system/icons/svg/
 * and generates src/content/ts/design-system/icons/svg-generated.ts
 */

import { readFileSync, writeFileSync, readdirSync } from 'node:fs';
import { resolve, basename } from 'node:path';

const SVG_DIR = resolve('src/content/ts/design-system/icons/svg');
const OUTPUT_FILE = resolve('src/content/ts/design-system/icons/svg-generated.ts');

const files = readdirSync(SVG_DIR).filter((f) => f.endsWith('.svg'));

let output = `// Auto-generated by scripts/ts/generate-icons.mts - do not edit manually\n\n`;

for (const file of files) {
  const name = basename(file, '.svg').replace(/-/g, '_');
  const content = readFileSync(resolve(SVG_DIR, file), 'utf-8')
    .replace(/`/g, '\\`')
    .replace(/\$\{/g, '\\${');
  output += `export const ${name} = \`${content}\`;\n`;
}

writeFileSync(OUTPUT_FILE, output);
console.log(`Generated ${OUTPUT_FILE} with ${files.length} SVGs`);
